# Vault — environment template. Committed. Contains NO real values.
# Copy to .env.local and fill in. Every variable is required; the app fails fast
# at startup if one is missing (Constitution III: nothing host-specific in source).

# --- Database ---------------------------------------------------------------
DATABASE_URL="mysql://user:password@127.0.0.1:3306/vault"

# --- Auth.js ----------------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# --- Dropbox ----------------------------------------------------------------
# App Console → Scoped access → App folder (CANNOT be changed after creation).
# Scopes required, and submitted before obtaining the refresh token:
#   files.content.write  files.content.read  files.metadata.read  sharing.write
DROPBOX_APP_KEY=""
DROPBOX_APP_SECRET=""

# One-time OAuth code flow with token_access_type=offline.
# See specs/001-dropbox-upload-approval/quickstart.md
DROPBOX_REFRESH_TOKEN=""

# The folder holding the approval-status folders. Empty for an App-folder app;
# for a Full Dropbox app, the containing folder, e.g.
#   /Some Team Folder/App Vault Folder
DROPBOX_ROOT_PATH=""

# Team-space namespace id, from who_am_i -> root_namespace_id. Leave empty for a
# personal account (where it equals home_namespace_id). Required when the
# content lives in a Dropbox Business team space rather than a personal folder.
DROPBOX_PATH_ROOT_NAMESPACE_ID=""

# --- Upload -----------------------------------------------------------------
UPLOAD_CHUNK_SIZE_BYTES=8388608
