{
  "name": "vault",
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "ds:sync": "node scripts/sync-design-system.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contract": "vitest run tests/contract",
    "db:statuses": "tsx scripts/seed-statuses.ts",
    "dropbox:connect": "tsx scripts/dropbox-connect.ts",
    "db:import-taxonomy": "tsx --tsconfig tsconfig.scripts.json scripts/import-taxonomy.ts",
    "db:seed-stages": "tsx --tsconfig tsconfig.scripts.json scripts/seed-stages.ts"
  },
  "type": "module",
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "dropbox": "^10.46.0",
    "mysql2": "^3.24.3",
    "next": "^16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
