# --- Secrets ----------------------------------------------------------------
# Never commit real credentials. .env.example is the committed template.
.env
.env.local
.env.*.local
.env.production
!.env.example

# --- Database exports --------------------------------------------------------
# Generated dumps of the live database. These carry real user email addresses
# and password hashes, so they are treated like a credentials file: kept local,
# transferred deliberately, never committed.
db-seed/

# --- Node / Next.js ---------------------------------------------------------
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# --- Tooling ----------------------------------------------------------------
coverage/
.vercel/
.turbo/
npm-debug.log*
yarn-error.log*
.eslintcache

# --- OS ---------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
